#!/usr/bin/env python3
"""Enforce the user's one-file-per-commit publication rule."""
import subprocess
import sys

paths = subprocess.check_output(
    ["git", "diff", "--cached", "--name-only", "--no-renames", "-z"]
).split(b"\0")
count = len([path for path in paths if path])
if count != 1:
    sys.exit(f"Commit rejected: expected exactly one staged file, found {count}.")
