#!/usr/bin/env python3
"""Require an independently chosen stage prefix."""
from pathlib import Path
import re
import sys

subject = Path(sys.argv[1]).read_text(encoding="utf-8").splitlines()[0]
if not re.fullmatch(r"[a-z][a-z0-9-]*: .+", subject):
    sys.exit("Commit rejected: use '<stage>: <file or concise change>'.")
