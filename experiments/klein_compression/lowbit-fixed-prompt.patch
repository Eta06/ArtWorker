+import Foundation
+import ArgumentParser
+import MLX
+import Flux2Core
+
+struct ArtWorkerEmbedding: AsyncParsableCommand {
+    static let configuration = CommandConfiguration(commandName: "artworker-embedding", abstract: "Export the fixed Klein base outpaint instruction, without image inference")
+    @Option(name: .long) var encoderPath: String
+    @Option(name: .long) var output: String
+    func run() async throws {
+        let target = URL(fileURLWithPath: output)
+        guard !FileManager.default.fileExists(atPath: target.path) else { throw ValidationError("Refusing to overwrite an embedding cache") }
+        let prompt = "Fill the green spaces according to the image"
+        let encoder = KleinTextEncoder(variant: .klein4B, quantization: .mlx4bit)
+        try await encoder.load(from: URL(fileURLWithPath: encoderPath))
+        let embeddings = try encoder.encode(prompt, upsample: false)
+        eval(embeddings)
+        try MLX.save(arrays: ["embeddings": embeddings], metadata: ["format": "artworker-fixed-fill-v1", "prompt": prompt, "model": "klein-4b-base", "text_quant": "4bit", "encoder_repo": "lmstudio-community/Qwen3-4B-MLX-4bit", "encoder_revision": "480ec45ecf06ae3c061e4ef11345d05c7fdb02f1"], url: target)
+        print("Fixed embedding exported: \(embeddings.shape), \(embeddings.dtype)")
+        encoder.unload()
+    }
+}
