+import Foundation
+import ArgumentParser
+import MLX
+
+struct ArtWorkerQuantProbe: ParsableCommand {
+    static let configuration = CommandConfiguration(commandName: "artworker-quant-probe", abstract: "Check Python/Swift quantized packing and matrix multiplication on a small fixture")
+    @Option(name: .long) var path: String
+    @Option(name: .long) var bits: Int
+    func run() throws {
+        guard [2, 3, 4].contains(bits) else { throw ValidationError("Expected 2, 3 or 4 bits") }
+        let arrays = try loadArrays(url: URL(fileURLWithPath: path))
+        guard let weight = arrays["weight"], let scales = arrays["scales"], let biases = arrays["biases"],
+              let input = arrays["input"], let reference = arrays["dequantized"], let product = arrays["product"] else {
+            throw ValidationError("Missing fixture tensors")
+        }
+        let decoded = dequantized(weight, scales: scales, biases: biases, groupSize: 64, bits: bits)
+        let output = quantizedMM(input, weight, scales: scales, biases: biases, transpose: true, groupSize: 64, bits: bits)
+        let decodeError = abs(decoded - reference).max().item(Float.self)
+        let productError = abs(output - product).max().item(Float.self)
+        let delta = (output - product).asType(.float32)
+        let productFloat = product.asType(.float32)
+        let relativeL2 = sqrt((delta * delta).sum()).item(Float.self) / max(sqrt((productFloat * productFloat).sum()).item(Float.self), 1e-12)
+        let report: [String: Any] = ["bits": bits, "dequant_max_abs": decodeError, "matmul_max_abs": productError,
+                                   "matmul_relative_l2": relativeL2, "relative_l2_limit": 0.001]
+        print(String(data: try JSONSerialization.data(withJSONObject: report, options: [.sortedKeys]), encoding: .utf8)!)
+        guard decodeError == 0, relativeL2 <= 0.001 else { throw ValidationError("Python/Swift quantized numerical compatibility failed") }
+    }
+}
